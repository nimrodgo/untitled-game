[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://scripts/data/effect.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/data/effects/gain_random_cards_effect.gd" id="2_fx"]
[ext_resource type="Script" path="res://scripts/data/card_data.gd" id="3_card"]

[sub_resource type="Resource" id="Resource_fx"]
script = ExtResource("2_fx")
amount = 2
zone = 0

[resource]
script = ExtResource("3_card")
id = &"trial_pack"
display_name = "Trial Pack"
on_play = Array[ExtResource("1_eff")]([SubResource("Resource_fx")])
on_play_text = "Add 2 random ⏳ cards from the shop's sets to your hand"
on_buy_text = "TBD"
card_set = 10
